# =============================================================================
# Zerodha Kite Connect Configuration
# =============================================================================
# Obtain API Key and Secret from the Zerodha Developer Console:
# https://developers.kite.trade/apps
KITE_API_KEY="your_kite_api_key_here"
KITE_API_SECRET="your_kite_api_secret_here"

# The Kite Connect access token is valid for one trading day and must be
# regenerated daily. Refer to README.md for the token generation procedure.
KITE_ACCESS_TOKEN="your_daily_kite_access_token_here"

# =============================================================================
# Google Sheets & Service Account Configuration
# =============================================================================
# Relative or absolute path to your Google Cloud Service Account JSON credentials file
GOOGLE_SERVICE_ACCOUNT_JSON="service_account.json"

# Name of the Google Spreadsheet containing stock ticker symbols in Column A
SPREADSHEET_NAME="nifty"

# Optional: Specific worksheet / tab title (leave empty to use the first worksheet)
WORKSHEET_NAME=""

# =============================================================================
# Output & Data Storage Configuration
# =============================================================================
# Output Excel filename for the RSI Historical Analysis report
OUTPUT_EXCEL="rsi_output.xlsx"

# Directory for consolidated raw market data exports (Monday + Expiry sessions)
RAW_DATA_OUTPUT_DIR="raw_data"

# Path to instrument token cache file (refreshed automatically every 24 hours)
INSTRUMENT_CACHE_FILE="instrument_cache.json"

# =============================================================================
# Logging Configuration
# =============================================================================
# Application log file location
LOG_FILE="app.log"

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"
